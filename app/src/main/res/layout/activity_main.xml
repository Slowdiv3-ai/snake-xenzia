<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#C0C0C0">
    
    <!-- Score bar OUTSIDE green screen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="15dp"
        android:paddingBottom="10dp">
        
        <TextView
            android:id="@+id/scoreText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Score: 0"
            android:textSize="14sp"
            android:textColor="#000000"
            android:typeface="monospace"
            android:layout_marginEnd="20dp"/>
        
        <TextView
            android:id="@+id/highScoreText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="High: 0"
            android:textSize="14sp"
            android:textColor="#000000"
            android:typeface="monospace"/>
        
    </LinearLayout>
    
    <!-- Green Nokia Screen (game area only) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#9BBC0F"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp">
        
        <FrameLayout
            android:id="@+id/gameContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        
    </LinearLayout>
    
    <!-- Menu overlay (hidden by default) -->
    <LinearLayout
        android:id="@+id/menuOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#C0C0C0"
        android:padding="20dp">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SNAKE XENZIA"
            android:textSize="24sp"
            android:textColor="#000000"
            android:typeface="monospace"
            android:layout_marginBottom="15dp"/>
        
        <Button
            android:id="@+id/menuStart"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="START"
            android:textSize="14sp"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="10dp"/>
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LEVEL:"
            android:textSize="12sp"
            android:textColor="#000000"
            android:typeface="monospace"/>
        
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="10dp">
            
            <Button
                android:id="@+id/levelEasy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EASY"
                android:textSize="12sp"
                android:backgroundTint="#4CAF50"
                android:layout_margin="3dp"/>
            
            <Button
                android:id="@+id/levelMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MED"
                android:textSize="12sp"
                android:backgroundTint="#FF9800"
                android:layout_margin="3dp"/>
            
            <Button
                android:id="@+id/levelHard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HARD"
                android:textSize="12sp"
                android:backgroundTint="#F44336"
                android:layout_margin="3dp"/>
            
        </LinearLayout>
        
        <Button
            android:id="@+id/soundToggle"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="SOUND: ON"
            android:textSize="12sp"
            android:backgroundTint="#2196F3"
            android:layout_marginBottom="10dp"/>
        
        <Button
            android:id="@+id/menuQuit"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="QUIT"
            android:textSize="12sp"
            android:backgroundTint="#F44336"
            android:layout_marginBottom="10dp"/>
        
    </LinearLayout>
    
    <!-- Controls area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        
        <!-- D-pad (LEFT side) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            
            <Button
                android:id="@+id/btnUp"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:text="▲"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2B2B2B"/>
            
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">
                
                <Button
                    android:id="@+id/btnLeft"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:text="◄"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2B2B2B"/>
                
                <Button
                    android:id="@+id/btnCenter"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:text="●"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#3A3A3A"/>
                
                <Button
                    android:id="@+id/btnRight"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:text="►"
                    android:textSize="20sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2B2B2B"/>
                
            </LinearLayout>
            
            <Button
                android:id="@+id/btnDown"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:text="▼"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2B2B2B"/>
            
        </LinearLayout>
        
        <!-- A/B buttons (RIGHT side - diagonal) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">
            
            <Button
                android:id="@+id/btnB"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:text="B"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#8B0000"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="25dp"/>
            
            <Button
                android:id="@+id/btnA"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:text="A"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#8B0000"/>
            
        </LinearLayout>
        
    </LinearLayout>
    
    <!-- Bottom buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="15dp">
        
        <Button
            android:id="@+id/btnPause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAUSE"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#555555"
            android:layout_marginEnd="15dp"/>
        
        <Button
            android:id="@+id/restartButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="START"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#555555"/>
        
    </LinearLayout>
    
</LinearLayout>
